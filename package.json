{
  "name": "sikraken-extension",
  "displayName": "Sikraken Extension",
  "description": "VS Code extension for Sikraken",
  "version": "0.1.1",
  "publisher": "OliwierJ",
  "license": "GPL-3.0-only",
  "repository": {
    "url": "https://github.com/OliwierJ/Sikraken-extension"
  },
  "contributors": [
    {
      "name": "OliwierJ",
      "email": "oliwierkjak@gmail.com"
    }
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sikraken.runSikrakenOnFile",
        "title": "Run Sikraken on File"
      },
      {
        "command": "sikraken.generateTestsOnFunction",
        "title": "Generate Tests on Function"
      },
      {
        "command": "sikraken.showInstallInstructions",
        "title": "Show Sikraken Dependency Instructions"
      },
      {
        "command": "sikraken.openDebugArtifacts",
        "title": "Sikraken: Open Debug Artifacts Folder"
      },
      {
        "command": "sikraken.openLatestDebugRun",
        "title": "Sikraken: Open Latest Debug Run"
      },
      {
        "command": "sikraken.deleteDebugArtifacts",
        "title": "Sikraken: Delete Debug Artifacts"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasDefinitionProvider && editorTextFocus && editorLangId == c",
          "command": "sikraken.runSikrakenOnFile",
          "group": "navigation@10"
        },
        {
          "when": "editorHasDefinitionProvider && editorTextFocus && editorLangId == c",
          "command": "sikraken.generateTestsOnFunction",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Sikraken Extension",
      "type": "object",
      "properties": {
        "sikraken.framework": {
          "type": "string",
          "enum": [
            "Unity"
          ],
          "markdownEnumDescriptions": [
            "Unity C Unit Test Framework"
          ],
          "enumItemLabels": [
            "Unity"
          ],
          "default": "Unity",
          "description": "Select the framework to use for generating test cases."
        },
        "sikraken.testGenerationMode": {
          "type": "string",
          "enum": [
            "prompt",
            "characterization",
            "userSpecified"
          ],
          "markdownEnumDescriptions": [
            "Ask the user each time they generate test cases",
            "Automatically generate characterization tests for the function",
            "Place placeholder test cases and let the user specify the expected results"
          ],
          "enumItemLabels": [
            "Prompt",
            "Characterization",
            "User Specified"
          ],
          "description": "Select the mode for generating test cases.",
          "default": "prompt"
        },
        "sikraken.sikrakenBudget": {
          "type": "number",
          "minimum": 1,
          "description": "Set the budget for Sikraken in seconds. This is the maximum time Sikraken will spend generating test cases.",
          "default": 10
        },
        "sikraken.testSuiteOutputDirectory": {
          "type": "string",
          "description": "Directory for generated Unity test suites, relative to the workspace when not absolute.",
          "default": "./tests"
        },
        "sikraken.debugMode": {
          "type": "boolean",
          "description": "Enable debug mode to save Sikraken's output and artifacts for debugging purposes.",
          "default": false
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vscode-test --grep Unit",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
