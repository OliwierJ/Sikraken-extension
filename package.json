{
  "name": "sikraken-extension",
  "displayName": "Sikraken Extension",
  "description": "VS Code extension for Sikraken",
  "version": "0.1.1",
  "publisher": "OliwierJ",
  "license": "GPL-3.0-only",
  "repository": {
    "url": "https://github.com/OliwierJ/Sikraken-extension"
  },
  "contributors": [
    {
      "name": "OliwierJ",
      "email": "oliwierkjak@gmail.com"
    }
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sikraken.generateTestsOnFunction",
        "title": "Generate and Validate Unity Tests with Sikraken"
      },
      {
        "command": "sikraken.showInstallInstructions",
        "title": "Show Sikraken Dependency Instructions"
      },
      {
        "command": "sikraken.openDebugArtifacts",
        "title": "Sikraken: Open Debug Artifacts Folder"
      },
      {
        "command": "sikraken.openLatestDebugRun",
        "title": "Sikraken: Open Latest Debug Run"
      },
      {
        "command": "sikraken.deleteDebugArtifacts",
        "title": "Sikraken: Delete Debug Artifacts"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorHasDefinitionProvider && editorTextFocus && editorLangId == c",
          "command": "sikraken.generateTestsOnFunction",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Sikraken Extension",
      "type": "object",
      "properties": {
        "sikraken.sikrakenBudget": {
          "type": "integer",
          "minimum": 1,
          "description": "Set the budget for Sikraken in seconds. This is the maximum time Sikraken will spend generating test cases.",
          "default": 10
        },
        "sikraken.stubFunctions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "C function names declared but not defined in the source file to model as environment stubs.",
          "default": []
        },
        "sikraken.ignoreInitialisers": {
          "type": "boolean",
          "description": "Treat initialised globals as inputs, for functions called after the program changes their values.",
          "default": false
        },
        "sikraken.debugMode": {
          "type": "boolean",
          "description": "Enable debug mode to save Sikraken's output and artifacts for debugging purposes.",
          "default": false
        }
      }
    }
  },
  "extensionDependencies": [
    "ms-vscode.cpptools-extension-pack"
  ],
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "test:unit": "vscode-test --grep Unit",
    "test:unit:quiet": "bash -o pipefail -c 'FORCE_COLOR=1 npm run test:unit 2>&1 | grep -vE \"\\\\[(ChatModelSelection|AgentHost)\\\\]|^Unknown channel:|AgentHost\"; exit \\${PIPESTATUS[0]}'",
    "test:integration": "vscode-test --grep Integration",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.140.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^4.1.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
